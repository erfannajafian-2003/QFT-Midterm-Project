Cell[CellGroupData[{

Cell["1. Part 1 \[LongDash] One loop and two regulators", "Section",
 CellChangeTimes->{{4.0043177302603817`*^9, 
  4.004317730977022*^9}},ExpressionUUID->"5fd7417e-0bdc-1648-b396-\
f747aca4fcff"],

Cell[CellGroupData[{

Cell["1.1 Generate and read the one-loop diagrams", "Subsection",ExpressionUUID->"e9dffefd-286a-8f43-811d-cf844e0b095e"],

Cell["\<\
Question | Generate all one-loop 1PI two-point and four-point diagrams for \
the real-scalar \[CapitalPhi]^4 model. Show CreateTopologies, InsertFields, \
Paint, CreateFeynAmp and FCFAConvert. Label external momenta, determine \
symmetry factors, identify s/t/u channels, and give converted integrands and \
ToPaVe forms.
Derivation | The two-point 1PI graph is the tadpole with symmetry factor 1/2. \
The four-point 1PI graphs are the three bubble pairings, with symmetry factor \
1/2 in each channel. With all external momenta incoming, P12=p1+p2, P13=p1+p3 \
and P14=p1+p4. In Euclidean conventions the loop corrections are \
\[CapitalDelta]\[CapitalGamma]^(2)=\[Lambda]T/2 and \[CapitalDelta]\
\[CapitalGamma]^(4)=-(\[Lambda]^2/2)[B(P12)+B(P13)+B(P14)].
Check | Verify the generated graph counts and symmetry factors from the \
FeynArts output. Check momentum conservation p1+p2+p3+p4=0 and compare the \
scalar denominators with T and B(P).\
\>", "Text",
 CellChangeTimes->{{4.0043178613333282`*^9, 
  4.0043178670486584`*^9}},ExpressionUUID->"be079595-c887-b34e-a84c-\
edc4d7a9e04e"],

Cell[CellGroupData[{

Cell["FeynArts/FeynCalc package setup and reproducible Phi4 model", \
"Subsubsection",ExpressionUUID->"8255a39e-0a81-d940-ab11-cedc36a7078b"],

Cell["\:067e", "Text",
 CellChangeTimes->{{4.0043178883485184`*^9, 4.004317889561661*^9}, 
   4.0043180353348103`*^9},ExpressionUUID->"301bf285-5610-8b4c-b8ae-\
4007a5044835"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<FeynArts`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$FeynArtsModel", " ", "=", " ", "\"\<Phi4\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"faFile", " ", "=", " ", 
   RowBox[{"FindFile", "[", "\"\<FeynArts`\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"faDir", " ", "=", " ", 
   RowBox[{"DirectoryName", "[", "faFile", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"modelDir", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"faDir", ",", " ", "\"\<Models\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phi4File", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"modelDir", ",", " ", "\"\<Phi4.mod\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<FeynArts version: \>\"", ",", " ", "$FeynArtsVersion"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Phi4 model file exists: \>\"", ",", " ", 
    RowBox[{"FileExistsQ", "[", "phi4File", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Model path: \>\"", ",", " ", "modelDir"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"f3b92ec7-4fd9-b646-b4d3-54a088a01807"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two-point tadpole: topology, insertion, diagram, amplitude", \
"Subsubsection",ExpressionUUID->"9d40d9b6-b461-cf4d-b51c-e6275ebc8464"],

Cell["\<\
The exclusion of Tadpoles must NOT be used here: the one-loop tadpole is the \
desired 1PI two-point graph.\
\>", "Text",ExpressionUUID->"d9fa85fa-775b-e94f-9049-5a4e72caa141"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top2", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"1", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ins2", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"top2", ",", " ", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], " ", "->", " ", 
      RowBox[{"S", "[", "1", "]"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "$FeynArtsModel"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "\"\<Lorentz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Two-point topologies: \>\"", ",", " ", 
    RowBox[{"Length", "[", "top2", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Inserted two-point diagrams: \>\"", ",", " ", 
    RowBox[{"Length", "[", "ins2", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"ins2", ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "Simple"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amp2", " ", "=", " ", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"ins2", ",", " ", 
     RowBox[{"Truncated", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PreFactor", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}], "\n", "amp2"}], "Input",ExpressionUUID->"ed9a2282-9ab4-5d44-9c08-\
250c9cd11fe4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-point bubbles: s, t and u channels", "Subsubsection",ExpressionUUID->"4b58b612-15b9-084c-a81f-ca84f2c1b570"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top4", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ins4", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"top4", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "$FeynArtsModel"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "\"\<Lorentz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Four-point topologies: \>\"", ",", " ", 
    RowBox[{"Length", "[", "top4", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Inserted four-point diagrams: \>\"", ",", " ", 
    RowBox[{"Length", "[", "ins4", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"ins4", ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "Simple"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"ColumnsXRows", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1"}], "}"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amp4", " ", "=", " ", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"ins4", ",", " ", 
     RowBox[{"Truncated", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PreFactor", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}], "\n", "amp4"}], "Input",ExpressionUUID->"1956880e-6640-b242-ba43-\
eafeae5900bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Momentum routing and FeynCalc conversion", "Subsubsection",ExpressionUUID->"95730fc0-6244-204a-8806-fc0dc1ebcd59"],

Cell["\<\
For FeynArts amplitudes, the two-point process is represented as S(p1) -> \
S(k1); impose k1=p1 after conversion, so the loop correction depends on the \
external Euclidean p\.b2. For the four-point process use p1,p2 incoming and \
p3,p4 outgoing, with p1+p2=p3+p4. The channel momenta are P_s=p1+p2, \
P_t=p1-p3 and P_u=p1-p4; their squared Euclidean invariants label the three \
bubble integrals. Keep this routing distinct from the all-incoming \
convention, where outgoing momenta are replaced by their negatives.\
\>", "Text",ExpressionUUID->"aa408de3-ca54-a84c-8404-863ef6ed60f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Conversion", " ", 
    RowBox[{"cell", ":", " ", 
     RowBox[{
     "evaluate", " ", "only", " ", "after", " ", "confirming", " ", "the", " ",
       "installed", " ", 
      RowBox[{"FeynCalc", "/", "FeynArts"}], " ", 
      RowBox[{"interface", ".", "\n", "   ", "Preserve"}], " ", "the", " ", 
      "raw", " ", "FeynArts", " ", "amplitudes", " ", "above", " ", "as", " ",
       "the", " ", "primary", " ", "diagram", " ", 
      RowBox[{"evidence", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"amp2FC", " ", "=", " ", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"amp2", ",", "\n", "  ", 
       RowBox[{"IncomingMomenta", " ", "->", " ", 
        RowBox[{"{", "p", "}"}]}], ",", " ", 
       RowBox[{"OutgoingMomenta", " ", "->", " ", 
        RowBox[{"{", "p", "}"}]}], ",", "\n", "  ", 
       RowBox[{"LoopMomenta", " ", "->", " ", 
        RowBox[{"{", "k", "}"}]}], ",", " ", 
       RowBox[{"ChangeDimension", " ", "->", " ", 
        RowBox[{"4", " ", "-", " ", 
         RowBox[{"2", " ", "epsFC"}]}]}], ",", "\n", "  ", 
       RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"SMP", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"amp4FC", " ", "=", " ", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"amp4", ",", "\n", "  ", 
       RowBox[{"IncomingMomenta", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
       RowBox[{"OutgoingMomenta", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", "\n", "  ", 
       RowBox[{"LoopMomenta", " ", "->", " ", 
        RowBox[{"{", "k", "}"}]}], ",", " ", 
       RowBox[{"ChangeDimension", " ", "->", " ", 
        RowBox[{"4", " ", "-", " ", 
         RowBox[{"2", " ", "epsFC"}]}]}], ",", "\n", "  ", 
       RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"SMP", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"amp2FC", ",", " ", "amp4FC"}], "}"}]}]}]], "Input",ExpressionUUID\
->"3578c3f1-0299-5646-b812-1919a955135b"],

Cell["\<\
The scalar tadpole denominator is 1/(k^2+m^2). A channel bubble has \
denominator 1/[(k^2+m^2)((k+P)^2+m^2)]. After Wick rotation, the Euclidean \
measure is \[Integral]d^dk_E/(2\[Pi])^d. In a Minkowski-to-Euclidean \
conversion, state the propagator and vertex i-factors before removing the \
overall amplitude phase. The scalar integrals are represented by A0/Tadpole \
and B0/Bubble functions; ToPaVe output and normalization must be inspected \
rather than assumed.\
\>", "Text",ExpressionUUID->"098c432a-58b3-834a-a6b1-d0a178202c47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Apply", " ", "ToPaVe", " ", "to", " ", "the", " ", "converted", " ", 
    "scalar", " ", "loop", " ", "expressions", " ", "after", " ", "tensor", " ", 
    RowBox[{"reduction", ".", "\n", "   ", "The"}], " ", "exact", " ", 
    "expression", " ", "passed", " ", "to", " ", "ToPaVe", " ", "depends", " ",
     "on", " ", "FCFAConvert", " ", 
    RowBox[{"output", "."}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"toPaVe2", " ", "=", " ", 
     RowBox[{"ToPaVe", "[", "amp2FC", "]"}]}], ";", "\n", "   ", 
    RowBox[{"toPaVe4", " ", "=", " ", 
     RowBox[{"ToPaVe", "[", "amp4FC", "]"}]}], ";"}], " ", "*)"}]}]], "Input",\
ExpressionUUID->"216f1f4e-4802-5e43-a830-1c2273eac083"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Diagrammatic consistency check", "Subsubsection",ExpressionUUID->"25f18535-0d1f-6b49-ba7a-76598f0235a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Algebraic", " ", "bookkeeping", " ", "checks", " ", "for", " ", "the", " ",
     "expected", " ", "diagrammatic", " ", 
    RowBox[{"coefficients", "."}]}], " ", "*)"}], "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"tadpoleSymmetryFactor", " ", "=", " ", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\n", " ", 
   RowBox[{
    RowBox[{"bubbleSymmetryFactors", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], ";"}], "\n", " ", 
   RowBox[{
    RowBox[{"channelLabels", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<s: (p1+p2)^2\>\"", ",", " ", "\"\<t: (p1-p3)^2\>\"", ",", 
       " ", "\"\<u: (p1-p4)^2\>\""}], "}"}]}], ";"}], "\n", " ", 
   RowBox[{"{", 
    RowBox[{
    "tadpoleSymmetryFactor", ",", " ", "bubbleSymmetryFactors", ",", " ", 
     "channelLabels"}], "}"}]}]}]], "Input",ExpressionUUID->"ce592fec-6d78-\
904c-be52-a8001622f403"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2 Evaluate the tadpole and bubble", "Subsection",ExpressionUUID->"150b7e4f-9252-6840-9aa4-93cba08732f2"],

Cell["\<\
Question | For |k|<\[CapitalLambda] calculate T and B(0) exactly in the sharp \
4D cutoff, expand through \[CapitalLambda]^-2, independently calculate the DR \
Laurent expansions through \[CurlyEpsilon]^0, identify power/log divergences \
and poles, and verify B(0)=-\[PartialD]T/\[PartialD]m^2 in both schemes.
Derivation | The radial 4D measure is d^4k/(2\[Pi])^4 = k^3 dk/(8\[Pi]^2). \
Integrating the tadpole and zero-momentum bubble gives the exact expressions \
below. In DR use d=4-\[CurlyEpsilon] and one \[Mu]^\[CurlyEpsilon] per loop.
Check | Differentiate T with respect to m\.b2 in each scheme. Compare the \
coefficients of the cutoff logarithm and DR pole, keeping the assignment's \
\[CurlyEpsilon] convention distinct from \[CurlyEpsilon]_FC.
Anchor IDs | A-12a sharp-cutoff radial measure; A-12b DR master integral; \
Fields Notes \[Section]\[Section]12\[Dash]13. Exact equation/page references \
open.
Status | derived; symbolic checks in AR-05 run by student; exact textbook \
anchors open.\
\>", "Text",ExpressionUUID->"2b42b23c-7b90-b140-866d-3c1dc40412ca"],

Cell[CellGroupData[{

Cell["Sharp 4D cutoff \[LongDash] exact results and asymptotic expansion", \
"Subsubsection",ExpressionUUID->"a16b3203-d3c7-b847-9416-e6d8780b9e2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tCut", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"cut", "^", "2"}], " ", "-", " ", 
      RowBox[{"m2", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"cut", "^", "2"}], "/", "m2"}]}], "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"16", " ", 
      RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bCut", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"cut", "^", "2"}], "/", "m2"}]}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"cut", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cut", "^", "2"}], " ", "+", " ", "m2"}], ")"}]}]}], ")"}], 
     "/", 
     RowBox[{"(", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"tCutSeries", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"tCut", ",", " ", 
      RowBox[{"{", 
       RowBox[{"cut", ",", " ", "Infinity", ",", " ", "2"}], "}"}]}], "]"}]}],
    ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bCutSeries", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"bCut", ",", " ", 
      RowBox[{"{", 
       RowBox[{"cut", ",", " ", "Infinity", ",", " ", "2"}], "}"}]}], "]"}]}],
    ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{
   "tCut", ",", " ", "bCut", ",", " ", "tCutSeries", ",", " ", "bCutSeries"}],
    "}"}]}]}], "Input",ExpressionUUID->"4dac0bc0-eb1b-b84a-a082-63865906b727"],

Cell["\<\
Thus T(\[CapitalLambda])=(1/16\[Pi]\.b2)[\[CapitalLambda]\.b2-m\.b2 ln(1+\
\[CapitalLambda]\.b2/m\.b2)] and B(0;\[CapitalLambda])=(1/16\[Pi]\.b2)[ln(1+\
\[CapitalLambda]\.b2/m\.b2)-\[CapitalLambda]\.b2/(\[CapitalLambda]\.b2+m\.b2)]\
. The tadpole contains a quadratic power divergence and a logarithm; the \
bubble is logarithmically divergent.\
\>", "Text",ExpressionUUID->"c7c973df-a46f-1d4a-b6ff-cea6d8984c26"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Dimensional regularization \[LongDash] exact expressions and Laurent \
expansions\
\>", "Subsubsection",ExpressionUUID->"00b6e804-1060-a648-97e7-2c542d4bc457"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tDR", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"mu", "^", "eps"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"2", " ", "-", " ", 
        RowBox[{"eps", "/", "2"}]}], ")"}]}]}], " ", 
    RowBox[{"m2", "^", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"eps", "/", "2"}]}], ")"}]}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "+", " ", 
      RowBox[{"eps", "/", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bDR", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"mu", "^", "eps"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "-", " ", 
         RowBox[{"eps", "/", "2"}]}], ")"}]}]}], " ", 
     RowBox[{"m2", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "eps"}], "/", "2"}], ")"}]}], " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"eps", "/", "2"}], "]"}]}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"tDRSeries", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"tDR", ",", " ", 
      RowBox[{"{", 
       RowBox[{"eps", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
   ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bDRSeries", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"bDR", ",", " ", 
      RowBox[{"{", 
       RowBox[{"eps", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
   ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"tDRSeries", ",", " ", "bDRSeries"}], "}"}]}]}], "Input",Expression\
UUID->"f6656a94-a8bd-7d44-9ab6-062ce11f6d54"],

Cell["\<\
With the convention used here, T_DR = m\.b2/(16\[Pi]\.b2)[-2/\[CurlyEpsilon] \
+ \[Gamma]_E - 1 - ln(4\[Pi]\[Mu]\.b2/m\.b2)] + O(\[CurlyEpsilon]), and \
B_DR(0)=1/(16\[Pi]\.b2)[2/\[CurlyEpsilon] - \[Gamma]_E + ln(4\[Pi]\[Mu]\.b2/m\
\.b2)] + O(\[CurlyEpsilon]). The pole is logarithmic in the bubble; the \
quadratic cutoff divergence has no direct pole counterpart in dimensional \
regularization.\
\>", "Text",ExpressionUUID->"353c65cc-c9a7-f843-9611-b110ce19c3dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Identity check in both regulators", "Subsubsection",ExpressionUUID->"5c8bb75e-6427-f542-bd43-866073d952d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"checkCutoffIdentity", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"bCut", " ", "+", " ", 
     RowBox[{"D", "[", 
      RowBox[{"tCut", ",", " ", "m2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"checkDRIdentity", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"bDR", " ", "+", " ", 
      RowBox[{"D", "[", 
       RowBox[{"tDR", ",", " ", "m2"}], "]"}]}], "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"checkCutoffIdentity", ",", " ", "checkDRIdentity"}], 
   "}"}]}]}], "Input",ExpressionUUID->"06ccba4f-1a68-5b48-8659-7db86a43925a"],

Cell["\<\
Expected result: {0,0}. The identity is a useful independent check of \
normalization and signs.\
\>", "Text",ExpressionUUID->"90b2c1df-4e9e-1d47-b87e-a9cbb7f6d93c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.3 Fix counterterms and compare regulators", "Subsection",ExpressionUUID->"c38687b7-ac41-3d49-a293-6ed8f96848cf"],

Cell["\<\
Question | Impose \[CapitalGamma]^(2)(0)=m\.b2, \
\[PartialD]\[CapitalGamma]^(2)/\[PartialD]p\.b2|0=1 and \
\[CapitalGamma]^(4)(0)=\[Lambda] in each regulator. Derive \[Delta]Z\
\[CurlyPhi], \[Delta]m\.b2 and \[Delta]\[Lambda]. Compare B(P)-B(0) and its \
slope at P\.b2=0 as the regulators are removed. For a sharp cutoff form the \
convergent difference and take \[CapitalLambda]\[RightArrow]\[Infinity] \
before shifting loop momentum.
Derivation | From \[CapitalGamma]^(2)=p\.b2+m\.b2+\[Delta]Z\[CurlyPhi] p\.b2+\
\[Delta]m\.b2+(\[Lambda]/2)T, the conditions give \[Delta]m\.b2=-\[Lambda]T/2 \
and \[Delta]Z\[CurlyPhi]=0 at one loop. From \[CapitalGamma]^(4)=\[Lambda]+\
\[Delta]\[Lambda]-(\[Lambda]\.b2/2)\[CapitalSigma]_channels B(P), the \
zero-momentum condition gives \[Delta]\[Lambda]=3\[Lambda]\.b2B(0)/2.
Check | Verify all three subtraction conditions by substitution. In DR the \
finite bubble difference is expressible with a Feynman parameter; its \
low-momentum slope is -1/(96\[Pi]\.b2m\.b2). The hard-cutoff finite-momentum \
difference must be formed before shifting the loop momentum.
Anchor IDs | A-13a MOM conditions; A-13b one-loop counterterms; Fields Notes \
\[Section]\[Section]12\[Dash]13. Exact equation/page references open.
Status | counterterms derived; DR finite difference checked; hard-cutoff \
finite-momentum limit open.\
\>", "Text",ExpressionUUID->"57347e36-6db2-3d46-9f67-0fd1dd9a9979"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"deltaM2", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "lam"}], " ", 
    RowBox[{"tCut", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaZphi1", " ", "=", " ", "0"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaLam", " ", "=", " ", 
    RowBox[{"3", " ", 
     RowBox[{"lam", "^", "2"}], " ", 
     RowBox[{"bCut", "/", "2"}]}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"deltaM2", ",", " ", "deltaZphi1", ",", " ", "deltaLam"}], 
   "}"}]}]}], "Input",ExpressionUUID->"820f97fe-9b74-b74a-8091-6728f965c8d6"],

Cell[CellGroupData[{

Cell["Finite bubble difference in DR", "Subsubsection",ExpressionUUID->"34ec93f3-219b-4049-98f6-c4739700ba8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bDiff", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"x", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
         RowBox[{"q2", "/", "m2"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{
        RowBox[{"m2", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"q2", " ", ">=", " ", "0"}]}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bDiffSlope", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bDiff", ",", " ", "q2"}], "]"}], " ", "/.", " ", 
       RowBox[{"q2", " ", "->", " ", "0"}]}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{"m2", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"bDiff", ",", " ", "bDiffSlope"}], "}"}]}]}], "Input",ExpressionUUI\
D->"5be8f3ca-1fdb-df4d-b428-3be6df984f7c"],

Cell["\<\
The slope is \[PartialD][B(P)-B(0)]/\[PartialD]P\.b2|0 = \
-1/(96\[Pi]\.b2m\.b2). The finite difference is UV convergent. For a sharp \
cutoff do not shift the integration variable in either divergent integral \
separately; take the cutoff limit of the convergent difference first.\
\>", "Text",ExpressionUUID->"bf7197ef-4027-8d41-9cc2-5e6570c76253"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Subtraction-condition check", "Subsubsection",ExpressionUUID->"bba345e3-a216-ef43-a8aa-80cee9178950"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Symbolic", " ", "substitution", " ", "into", " ", "the", " ", "stated", " ",
      "one"}], "-", 
    RowBox[{"loop", " ", "\[CapitalGamma]", " ", 
     RowBox[{"functions", "."}]}]}], " ", "*)"}], "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"gamma2At0", " ", "=", " ", 
     RowBox[{"m2", " ", "+", " ", "deltaM2", " ", "+", " ", 
      RowBox[{"lam", " ", 
       RowBox[{"tCut", "/", "2"}]}]}]}], ";"}], "\n", " ", 
   RowBox[{
    RowBox[{"gamma2Slope", " ", "=", " ", 
     RowBox[{"1", " ", "+", " ", "deltaZphi1"}]}], ";"}], "\n", " ", 
   RowBox[{
    RowBox[{"gamma4At0", " ", "=", " ", 
     RowBox[{"lam", " ", "+", " ", "deltaLam", " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"lam", "^", "2"}], "/", "2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"3", " ", "bCut"}], ")"}]}]}]}], ";"}], "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gamma2At0", " ", "==", " ", "m2"}], ",", " ", 
      RowBox[{"gamma2Slope", " ", "==", " ", "1"}], ",", " ", 
      RowBox[{"gamma4At0", " ", "==", " ", "lam"}]}], "}"}], 
    "]"}]}]}]], "Input",ExpressionUUID->"49d47eec-0e87-c740-979a-\
286c85f224ef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.4 Derive the beta function and fixed point", "Subsection",ExpressionUUID->"6becb222-4f10-a840-bfdd-106430025474"],

Cell["\<\
Question | Use DR pole counterterms to derive the MS beta function through g\
\.b2 and the nonzero fixed point through \[CurlyEpsilon]. Show the one-loop \
field counterterm and explain why the tadpole cannot change the momentum \
exponent. Distinguish MS from the finite MOM conditions in 1.3.
Derivation | With g0=\[Mu]^\[CurlyEpsilon] g Zg and \
Zg=1+3g/\[CurlyEpsilon]+O(g\.b2), differentiating at fixed bare coupling \
gives \[Beta](g)=-\[CurlyEpsilon]g+3g\.b2+O(g\.b3). The non-Gaussian zero is \
g*=\[CurlyEpsilon]/3+O(\[CurlyEpsilon]\.b2). At one loop the tadpole is \
momentum independent, hence \[Delta]Z\[CurlyPhi]^(1)=0 and it cannot \
renormalize the p\.b2 coefficient.
Check | Substitute g* into \[Beta] and verify the zero to the retained order. \
Keep MS pole subtraction conceptually separate from the finite MOM conditions \
of 1.3.
Anchor IDs | A-14a bare/renormalized coupling; A-14b beta definition; Fields \
Notes \[Section]\[Section]20\[Dash]21 (RG/fixed point discussion); exact \
equation/page references open.
Status | one-loop derivation and symbolic check completed; textbook anchors \
open.\
\>", "Text",ExpressionUUID->"adab8108-877d-2648-917c-59eb9fa437d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"betaG", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "eps"}], " ", "g"}], " ", "+", " ", 
    RowBox[{"3", " ", 
     RowBox[{"g", "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"gStar", " ", "=", " ", 
    RowBox[{"eps", "/", "3"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"betaG", ",", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"betaG", " ", "/.", " ", 
      RowBox[{"g", " ", "->", " ", "gStar"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"betaG", ",", " ", "g"}], "]"}], " ", "/.", " ", 
     RowBox[{"g", " ", "->", " ", "gStar"}]}]}], "}"}]}]}], "Input",Expression\
UUID->"f1a60057-9f49-c142-bae1-9f41ad90055c"],

Cell["\<\
At one loop Z\[CurlyPhi]=1+O(g\.b2). The derivative \[Beta]'(g*)=\
\[CurlyEpsilon] in this convention. This is the Callan\[Dash]Symanzik beta \
function; do not confuse its sign with an infrared Wilsonian flow parameter \
defined as t=ln b.\
\>", "Text",ExpressionUUID->"d0925f1f-dfca-0e40-bb58-fa6b378f81a3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Part 2 \[LongDash] Critical exponents and water", "Section",ExpressionUUID->"1360e848-5256-924e-a1af-c7510451aebe"],

Cell[CellGroupData[{

Cell["2.1 Calculate the two-loop two-point function", "Subsection",ExpressionUUID->"79fc8aad-a5fa-8b4f-9d96-10d588ccc5ba"],

Cell["\<\
Question | Generate all two-loop 1PI two-point diagrams with FeynArts and \
convert them with FeynCalc. Identify p-dependent graphs and derive the sunset \
symmetry factor. Evaluate H(p) by two successive massless one-loop \
convolutions, give the gamma-function expression, Laurent expansion and \
p\.b2/\[CurlyEpsilon] coefficient. Account for four-point subdivergences and \
show why their counterterm insertions do not affect the p\.b2 pole.
Derivation | At criticality use massless propagators and p\.b2>0. The sunset \
is the momentum-dependent two-loop 1PI graph and has symmetry factor 1/6. The \
massless convolution identity is used twice. The exact result to be checked \
is H(p)=\[Mu]^(2\[CurlyEpsilon])(p\.b2)^(1-\[CurlyEpsilon])/(4\[Pi])^(4-\
\[CurlyEpsilon]) \[Times] \[CapitalGamma](1-\[CurlyEpsilon]/2)^3 \
\[CapitalGamma](\[CurlyEpsilon]-1)/\[CapitalGamma](3-3\[CurlyEpsilon]/2). Its \
gamma ratio begins \
-1/(2\[CurlyEpsilon])+\[Gamma]_E/2-13/8+O(\[CurlyEpsilon]); therefore H has p\
\.b2 pole -p\.b2/[2(4\[Pi])^4 \[CurlyEpsilon]].
Check | Independently reproduce the expression by sequential convolution in \
Mathematica. Verify the p\.b2 pole after expanding the full prefactor, not \
just the gamma ratio. Separate UV and IR poles in scaleless subgraphs before \
claiming cancellation; a scaleless tadpole set to zero does not by itself \
prove absence of a UV subdivergence.
Anchor IDs | A-21a massless convolution; A-21b sunset integral; Fields Notes \
\[Section]15 and \[Section]\[Section]20\[Dash]21. Exact equation/page \
references open.
Status | sunset pole analytically derived; finite prefactor/log and complete \
subdivergence bookkeeping require independent verification.\
\>", "Text",ExpressionUUID->"4605deab-0232-c944-9ea1-f3bd5cac5084"],

Cell[CellGroupData[{

Cell["FeynArts generation of two-loop two-point topologies", "Subsubsection",ExpressionUUID->"ae640021-5d3f-eb41-998c-38466aa5c0be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top2L", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"1", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ins2L", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"top2L", ",", " ", 
     RowBox[{
      RowBox[{"S", "[", "1", "]"}], " ", "->", " ", 
      RowBox[{"S", "[", "1", "]"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "$FeynArtsModel"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "\"\<Lorentz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"ins2L", ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "True"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amp2L", " ", "=", " ", 
   RowBox[{"CreateFeynAmp", "[", "ins2L", "]"}]}], 
  ";"}], "\n", "amp2L"}], "Input",ExpressionUUID->"3c727dc1-2a7e-5847-80cb-\
c8a7205fea9f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Convert using two independent loop momenta", "Subsubsection",ExpressionUUID->"8a9737e1-2e65-7045-8676-4a039cc2f722"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"amp2LFC", " ", "=", " ", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"amp2L", ",", "\n", "  ", 
     RowBox[{"IncomingMomenta", " ", "->", " ", 
      RowBox[{"{", "p", "}"}]}], ",", " ", 
     RowBox[{"OutgoingMomenta", " ", "->", " ", 
      RowBox[{"{", "p", "}"}]}], ",", "\n", "  ", 
     RowBox[{"LoopMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "ell"}], "}"}]}], ",", " ", 
     RowBox[{"ChangeDimension", " ", "->", " ", 
      RowBox[{"4", " ", "-", " ", 
       RowBox[{"2", " ", "epsFC"}]}]}], ",", "\n", "  ", 
     RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"SMP", " ", "->", " ", "True"}]}], "]"}]}], 
  ";"}], "\n", "amp2LFC"}], "Input",ExpressionUUID->"8419e283-5f4f-8a40-87b0-\
81ea52d052c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Massless one-loop convolution identity", "Subsubsection",ExpressionUUID->"dbff3920-c364-3141-8714-a50a83d84f16"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"conv", "[", 
    RowBox[{"a_", ",", " ", "b_", ",", " ", "pp_", ",", " ", "dd_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", "pp", ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dd", "/", "2"}], " ", "-", " ", "a", " ", "-", " ", "b"}], 
       ")"}]}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"dd", "/", "2"}], ")"}]}]}], " ", "*", "\n", "  ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"dd", "/", "2"}], " ", "-", " ", "a"}], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"dd", "/", "2"}], " ", "-", " ", "b"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"a", " ", "+", " ", "b", " ", "-", " ", 
       RowBox[{"dd", "/", "2"}]}], "]"}], "/", "\n", "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", "a", "]"}], " ", 
       RowBox[{"Gamma", "[", "b", "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"dd", " ", "-", " ", "a", " ", "-", " ", "b"}], "]"}]}], 
      ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"conv", "[", 
  RowBox[{"1", ",", " ", "1", ",", " ", "p2", ",", " ", 
   RowBox[{"4", " ", "-", " ", "eps"}]}], "]"}]}], "Input",ExpressionUUID->\
"7787d799-04ed-4f4b-afdd-8c2cda906edb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sunset expression and pole extraction", "Subsubsection",ExpressionUUID->"a70e70d1-fd0c-3c46-9fa5-7071d3595445"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sunsetRatio", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"eps", "/", "2"}]}], "]"}], "^", "3"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"eps", " ", "-", " ", "1"}], "]"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"3", " ", "-", " ", 
       RowBox[{"3", " ", 
        RowBox[{"eps", "/", "2"}]}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"sunSet", " ", "=", " ", 
    RowBox[{
     RowBox[{"mu", "^", 
      RowBox[{"(", 
       RowBox[{"2", " ", "eps"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"p2", "^", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "eps"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"4", " ", "-", " ", "eps"}], ")"}]}]}], " ", 
     "sunsetRatio"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"sunsetRatioSeries", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"sunsetRatio", ",", " ", 
      RowBox[{"{", 
       RowBox[{"eps", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], 
   ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"sunsetPole", " ", "=", " ", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{"sunSet", ",", " ", 
      RowBox[{"{", 
       RowBox[{"eps", ",", " ", "0", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"sunsetRatioSeries", ",", " ", "sunsetPole"}], "}"}]}]}], "Input",E\
xpressionUUID->"173699ff-50eb-5845-b4fe-faa6a1896ba7"],

Cell["\<\
The coefficient expected for the pole is -p\.b2/[2(4\[Pi])^4] when \[Mu] \
factors are expanded consistently. The finite term must be extracted from the \
complete expression, including \[Mu]^(2\[CurlyEpsilon]), (p\.b2)^(-\
\[CurlyEpsilon]), and (4\[Pi])^\[CurlyEpsilon]; do not identify the \
gamma-ratio finite constant alone with the full finite part.\
\>", "Text",ExpressionUUID->"9356ad68-05c8-de46-93aa-d54650bd2753"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Subdivergence discussion", "Subsubsection",ExpressionUUID->"6a2b00ce-a215-5947-8730-18dea8e31d21"],

Cell["\<\
The two-loop sunset has four-point one-loop subdivergent subgraphs. Their \
local counterterm insertions are momentum independent at the level of the \
four-point subgraph; they do not generate a new p\.b2/\[CurlyEpsilon] \
contribution to the two-point wavefunction counterterm. However, massless DR \
can set scaleless tadpole-like insertions to zero while hiding a UV/IR \
cancellation. A complete proof should introduce an IR regulator or use an \
R*/infrared-rearrangement argument and display the pole separation. This item \
remains open until that bookkeeping is explicitly shown.\
\>", "Text",ExpressionUUID->"723e088f-a3f0-a044-a467-bbc066d331fb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Obtain Z\[CurlyPhi], \[Gamma]\[CurlyPhi] and \[Eta]", "Subsection",ExpressionUUID->"962cfed4-ed43-5f4c-98c4-5e87d2498cfb"],

Cell["\<\
Question | Determine the sunset contribution to the inverse propagator \
including its sign. Extract Z\[CurlyPhi], derive \[Gamma]\[CurlyPhi](g)=1/2 \
\[Mu] d(log Z\[CurlyPhi])/d\[Mu] at fixed bare parameters, use \[Eta]=2\
\[Gamma]\[CurlyPhi](g*) and check against the finite log(p\.b2/\[Mu]\.b2) \
term. Explain why the one-loop g* suffices through \[CurlyEpsilon]\.b2.
Derivation | With the Euclidean self-energy contribution -\[Lambda]\.b2H/6 \
and H_pole=-p\.b2/[2(4\[Pi])^4\[CurlyEpsilon]], the inverse-propagator pole \
is +g\.b2p\.b2/(12\[CurlyEpsilon]). Thus Z\[CurlyPhi]=1-g\.b2/(12\
\[CurlyEpsilon])+O(g\.b3). At fixed bare parameters, \[Gamma]\[CurlyPhi](g)=g\
\.b2/12+O(g\.b3), and with g*=\[CurlyEpsilon]/3+O(\[CurlyEpsilon]\.b2), \
\[Eta]=2\[Gamma]\[CurlyPhi](g*)=\[CurlyEpsilon]\.b2/54+O(\[CurlyEpsilon]\.b3).
Check | Verify the sign by combining the sunset prefactor and H pole. The \
finite logarithm in p\.b2/\[Mu]\.b2 must reproduce the same anomalous \
scaling. Since \[Gamma]\[CurlyPhi] starts at g\.b2, the O(\[CurlyEpsilon]) \
correction to g* first affects \[Eta] at O(\[CurlyEpsilon]\.b3).
Anchor IDs | A-22a field renormalization; A-22b anomalous dimension; Fields \
Notes \[Section]\[Section]20\[Dash]21. Exact equation/page references open.
Status | pole-based coefficient derived and AR-05 symbolic target checked; \
explicit finite-log check and subdivergence-complete derivation open.\
\>", "Text",ExpressionUUID->"d0bff58a-be29-974a-99c4-b9e7a60c83b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zPhi", " ", "=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"g", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"12", " ", "eps"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"gammaPhi", " ", "=", " ", 
    RowBox[{
     RowBox[{"g", "^", "2"}], "/", "12"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"etaExpr", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", "gammaPhi"}], ")"}], " ", "/.", " ", 
     RowBox[{"g", " ", "->", " ", "gStar"}]}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"zPhi", ",", " ", "gammaPhi", ",", " ", "etaExpr", ",", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"etaExpr", ",", " ", 
      RowBox[{"{", 
       RowBox[{"eps", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
   "}"}]}]}], "Input",ExpressionUUID->"aa90277f-49c9-0047-b950-bcfdfc9292a1"],

Cell["\<\
The critical propagator scales as G(p) \[Proportional] \
(p\.b2)^(-1+\[Eta]/2)=p^(-2+\[Eta]). The corresponding log-log scattering \
slope is -2+\[Eta].\
\>", "Text",ExpressionUUID->"a4de7b12-5eef-d048-b163-304edc51db1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Derive \[Delta] and compare with the critical isotherm", \
"Subsection",ExpressionUUID->"949cdab9-4084-0743-a2d9-efc012134725"],

Cell["\<\
Question | Add a uniform source h through S_h=S-\[Integral]d^dx h\[CurlyPhi] \
and define M=\:27e8\[CurlyPhi]\:27e9_h. Derive \[Delta] from scaling \
dimensions, expand through \[CurlyEpsilon]\.b2 before setting \
\[CurlyEpsilon]=1, map the order parameter and source to density and pressure \
for water, and give the scattering slope. Compare with the \
assignment-supplied water-fit value \[Delta]_water=4.324 (its experimental \
source and fit window must be cited separately) and the 3D Ising bootstrap \
input \[CapitalDelta]\[Sigma]=0.518148806(24).
Derivation | \[CapitalDelta]\[CurlyPhi]=(d-2+\[Eta])/2 and \
y_h=(d+2-\[Eta])/2. At criticality M\[Tilde]sgn(h)|h|^(\[CapitalDelta]\
\[CurlyPhi]/y_h), so \
\[Delta]=y_h/\[CapitalDelta]\[CurlyPhi]=(d+2-\[Eta])/(d-2+\[Eta]). With d=4-\
\[CurlyEpsilon] and \[Eta]=\[CurlyEpsilon]\.b2/54, \
\[Delta]=3+\[CurlyEpsilon]+25\[CurlyEpsilon]\.b2/54+O(\[CurlyEpsilon]\.b3). \
The formal \[CurlyEpsilon]=1 estimate is \[Delta]\[TildeTilde]4.462963. For \
the liquid-gas critical isotherm, M\[Proportional]\[Rho]-\[Rho]_c and h\
\[Proportional]P-P_c, so (P-P_c)/P_c\[Tilde]A sgn(\[CapitalDelta]\[Rho])|\
\[CapitalDelta]\[Rho]/\[Rho]_c|^\[Delta], with nonuniversal A.
Check | Compare the epsilon-expansion estimate with water and bootstrap \
benchmarks. From \[CapitalDelta]\[Sigma], compute \[Eta]_B=2\[CapitalDelta]\
\[Sigma]-1 and \[Delta]_B=3/\[CapitalDelta]\[Sigma]-1. Scattering slope is \
-2+\[Eta]. Label \[CurlyEpsilon]=1 as a truncated extrapolation, not a \
controlled exact 3D result.
Anchor IDs | A-23a scaling dimensions; A-23b equation of state; Fields Notes \
\[Section]\[Section]20\[Dash]21. Exact equation/page references open. \
Water/bootstrap are external comparison inputs from the project brief.
Status | scaling derivation and \[CurlyEpsilon] expansion checked; numerical \
comparison generated below; textbook page-level anchors open.\
\>", "Text",ExpressionUUID->"d351bc71-d4ec-034b-89d9-25165f4b2fc1"],

Cell[CellGroupData[{

Cell["Scaling derivation and epsilon expansion", "Subsubsection",ExpressionUUID->"4ba8c9a5-f49f-274b-8cfd-ec3b0ff1d5d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"etaEps2", " ", "=", " ", 
   RowBox[{
    RowBox[{"eps", "^", "2"}], "/", "54"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaExact", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
      "4", " ", "-", " ", "eps", " ", "+", " ", "2", " ", "-", " ", 
       "etaEps2"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
      "4", " ", "-", " ", "eps", " ", "-", " ", "2", " ", "+", " ", 
       "etaEps2"}], ")"}]}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaSeries", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{"deltaExact", ",", " ", 
       RowBox[{"{", 
        RowBox[{"eps", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
     "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"delta3D", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"deltaSeries", " ", "/.", " ", 
       RowBox[{"eps", " ", "->", " ", "1"}]}], ",", " ", "10"}], "]"}]}], 
   ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"{", 
   RowBox[{"deltaExact", ",", " ", "deltaSeries", ",", " ", "delta3D"}], 
   "}"}]}]}], "Input",ExpressionUUID->"74631d8d-7d57-004e-9d03-b4aa33519542"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Water equation of state and scattering", "Subsubsection",ExpressionUUID->"ce450978-1520-1841-ae96-b32664756409"],

Cell["\<\
Let \[CapitalDelta]\[Rho]=\[Rho]-\[Rho]_c. The critical-isotherm scaling form \
is (P-P_c)/P_c \[Tilde] A Sign[\[CapitalDelta]\[Rho]] Abs[\[CapitalDelta]\
\[Rho]/\[Rho]_c]^\[Delta]. The amplitude A is nonuniversal and depends on \
metric factors. In the critical scattering window \[Xi]^-1\[LessLess]q\
\[LessLess]a^-1, S(q)\[Proportional]q^(-2+\[Eta]), so the log-log slope is \
-2+\[Eta].\
\>", "Text",ExpressionUUID->"d0ddc080-2a7a-db46-94d5-5b232edf47a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"deltaWater", " ", "=", " ", "4.324"}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaSigma", " ", "=", " ", "0.518148806"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"etaBootstrap", " ", "=", " ", 
    RowBox[{
     RowBox[{"2", " ", "deltaSigma"}], " ", "-", " ", "1"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"deltaBootstrap", " ", "=", " ", 
    RowBox[{
     RowBox[{"3", "/", "deltaSigma"}], " ", "-", " ", "1"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"eta3DTruncated", " ", "=", " ", 
    RowBox[{"1", "/", "54"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"scatteringSlope3D", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "+", " ", "eta3DTruncated"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"comparison", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\[Delta] (epsilon expansion, \[CurlyEpsilon]=1 truncated)\
\>\"", ",", " ", "delta3D"}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Delta] (water fit; assignment input)\>\"", ",", " ", 
        "deltaWater"}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Delta] (3D Ising bootstrap from \
\[CapitalDelta]\[Sigma])\>\"", ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"deltaBootstrap", ",", " ", "10"}], "]"}]}], "}"}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Eta] (epsilon expansion, \[CurlyEpsilon]=1 truncated)\>\
\"", ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"eta3DTruncated", ",", " ", "10"}], "]"}]}], "}"}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Eta] (3D Ising bootstrap from \
\[CapitalDelta]\[Sigma])\>\"", ",", " ", 
        RowBox[{"N", "[", 
         RowBox[{"etaBootstrap", ",", " ", "10"}], "]"}]}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Scattering slope -2+\[Eta] (epsilon expansion)\>\"", ",", 
        " ", 
        RowBox[{"N", "[", 
         RowBox[{"scatteringSlope3D", ",", " ", "10"}], "]"}]}], "}"}]}], 
     "}"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"comparison", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Quantity\>\"", ",", " ", "\"\<Value\>\""}], "}"}]}], 
     "]"}], ",", " ", 
    RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]}], "Input",ExpressionU\
UID->"d7da6331-a761-7542-95d1-9ef4710b0684"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

